<Window x:Class="DocumentGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Generator" Height="790" Width="1260"
        MinHeight="650" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#E8EDF5"/><Setter Property="Foreground" Value="#24344D"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Document Generator" FontSize="27" FontWeight="SemiBold" Foreground="#17243A"/>
                <TextBlock Text="Бібліотека DOCX-шаблонів • заповнення • перегляд • генерація" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Content="Імпортувати DOCX" Click="ImportTemplate_Click" Background="#2457A7" Foreground="White"/>
                <Button Content="Резервна копія" Click="Backup_Click"/>
                <Button Content="Оновити" Click="Refresh_Click"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Бібліотека шаблонів" FontSize="17" FontWeight="SemiBold" Foreground="#17243A"/>
                        <TextBox x:Name="SearchBox" Margin="0,9,0,5" ToolTip="Пошук за назвою або категорією" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="Оберіть шаблон зі списку" Foreground="#64748B" FontSize="12"/>
                    </StackPanel>
                    <ListBox x:Name="TemplatesList" SelectionChanged="TemplatesList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="8" Margin="0,2" CornerRadius="6" Background="#F8FAFC">
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#24344D" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#64748B"/></StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock x:Name="SelectedTemplateTitle" Text="Оберіть шаблон" FontSize="20" FontWeight="SemiBold" Foreground="#17243A"/>
                            <TextBlock x:Name="TemplateInfo" Text="Після імпорту DOCX тут з'явиться інформація про змінні." Foreground="#64748B" Margin="0,5,0,16" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <Button Content="Перейменувати" Click="Rename_Click"/>
                            <Button Content="Видалити" Click="Delete_Click" Foreground="#B42318"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FieldsPanel"><TextBlock Text="Поля шаблону з'являться тут." Foreground="#94A3B8"/></StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Відкрити шаблон" Click="OpenTemplate_Click"/>
                        <Button Content="Очистити поля" Click="ClearFields_Click"/>
                        <Button Content="Перегляд" Click="Preview_Click" Background="#2457A7" Foreground="White"/>
                        <Button Content="Зберегти документ" Click="Generate_Click" Background="#16835D" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="Portable mode • значення змінних запам'ятовуються • перегляд перед збереженням • Word не обов'язковий" Foreground="#64748B" FontSize="11" Margin="2,14,0,0"/>
    </Grid>
</Window>
