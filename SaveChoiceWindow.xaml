<Window x:Class="DocumentGenerator.SaveChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Збереження документа" Height="280" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Як зберегти документ?" FontSize="18" FontWeight="SemiBold" Foreground="#17243A"/>
            <TextBlock Text="Оберіть спосіб іменування файлу" Foreground="#64748B" Margin="0,6,0,16"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="AutoName_Click">
                <StackPanel>
                    <TextBlock Text="Зберегти зі згенерованою назвою" FontWeight="SemiBold" Foreground="#17243A"/>
                    <TextBlock x:Name="AutoNamePreview" Text="" Foreground="#64748B" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Cursor="Hand" MouseLeftButtonUp="CustomName_Click">
                <StackPanel>
                    <TextBlock Text="Обрати назву файлу самостійно" FontWeight="SemiBold" Foreground="#17243A"/>
                    <TextBlock Text="Відкриється діалог збереження файлу" Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Скасувати" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/>
        </StackPanel>
    </Grid>
</Window>
